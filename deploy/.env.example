# zebra-lab settings. Copy with ./init-secrets.sh (fills every secret with random values);
# never commit the real .env.

# rehearsal | proxy | caddy   (see README.md "Modes")
LAB_MODE=rehearsal
# every site is <name>.${LAB_DOMAIN}: store acg dujiao zs2 sakura neon matcha
# rehearsal: lvh.me (resolves to 127.0.0.1 publicly, in-network via edge aliases)
LAB_DOMAIN=lvh.me
# rehearsal: host port of the edge (http://store.lvh.me:18480/)
EDGE_HTTP_PORT=18480
# proxy mode: the one local port the host proxy forwards all lab hostnames to
PROXY_PORT=18180
# caddy mode: ACME account e-mail
ACME_EMAIL=admin@example.com
# docker network of the lab (backends trust only this range as proxies)
LAB_SUBNET=172.30.77.0/24
# image tag to run (build.sh --platform linux/amd64 produces :amd64)
IMAGE_TAG=local
# reseller profit becomes withdrawable after N days (0 = immediately, for the e2e run)
SETTLEMENT_CONFIRM_DAYS=0

# ---- secrets (generated) ----
STORE_APP_SECRET=
STORE_JWT_SECRET=
STORE_USER_JWT_SECRET=
STORE_ADMIN_PASSWORD=
ZS2_APP_SECRET=
ZS2_JWT_SECRET=
ZS2_USER_JWT_SECRET=
ZS2_ADMIN_PASSWORD=
DUJIAO_APP_SECRET=
DUJIAO_JWT_SECRET=
DUJIAO_USER_JWT_SECRET=
DUJIAO_ADMIN_PASSWORD=
ACG_ADMIN_EMAIL=admin@acg.lab
ACG_ADMIN_PASSWORD=
# password of every test user the provisioner creates (buyers, resellers, supplier accounts)
LAB_USER_PASSWORD=
