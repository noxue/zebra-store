# zebra-lab vhosts for an existing host nginx (behind-proxy mode). Certificates are up to
# you (e.g. certbot --nginx -d store.${LAB_DOMAIN} -d acg.${LAB_DOMAIN} ...).
server {
    listen 443 ssl;
    http2 on;
    server_name store.${LAB_DOMAIN} sakura.${LAB_DOMAIN} neon.${LAB_DOMAIN} matcha.${LAB_DOMAIN}
                zs2.${LAB_DOMAIN} acg.${LAB_DOMAIN} dujiao.${LAB_DOMAIN};
    # ssl_certificate     /etc/letsencrypt/live/store.${LAB_DOMAIN}/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/store.${LAB_DOMAIN}/privkey.pem;
    client_max_body_size 20m;
    location / {
        proxy_pass http://127.0.0.1:${PROXY_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
server {
    listen 443 ssl;
    http2 on;
    server_name docs.${LAB_DOMAIN};
    root ${LAB_DIR}/docs;
    gzip on;
    location / { try_files $uri $uri.html $uri/ /404.html; }
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
}
server {
    listen 80;
    server_name store.${LAB_DOMAIN} sakura.${LAB_DOMAIN} neon.${LAB_DOMAIN} matcha.${LAB_DOMAIN}
                zs2.${LAB_DOMAIN} acg.${LAB_DOMAIN} dujiao.${LAB_DOMAIN} docs.${LAB_DOMAIN};
    return 301 https://$host$request_uri;
}
